{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "reset-project": "node ./scripts/reset-project.js",
    "start:android": "expo start --dev-client --android",
    "start:ios": "expo start --dev-client --ios",
    "start:tunnel:android": "expo start --dev-client --android --tunnel",
    "start:tunnel:ios": "expo start --dev-client --ios --tunnel",
    "start:go:android": "expo start --android",
    "start:go:ios": "expo start --ios",
    "build-run:android": "expo run:android",
    "build-run:ios": "expo run:ios",
    "build:cloud:ios": "eas build --profile development --platform ios",
    "build:cloud:android": "eas build --profile development --platform android",
    "build:testflight:ios": "eas build --platform ios --profile production",
    "submit:testflight:ios": "eas submit --platform ios --profile production --latest",
    "release:testflight:ios": "eas build --platform ios --profile production --auto-submit",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@ownlift/core": "workspace:*",
    "@ownlift/db": "workspace:*",
    "@ownlift/schemas": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "~55.0.4",
    "expo-blur": "~55.0.10",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.10",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.8",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.5",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.3",
    "expo-sharing": "~55.0.18",
    "expo-splash-screen": "~55.0.10",
    "expo-sqlite": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.18",
    "expo-web-browser": "~55.0.9",
    "lottie-react-native": "~7.3.8",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-graph": "^1.2.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@ownlift/eslint-config": "workspace:*",
    "@types/react": "~19.2.14",
    "eas-cli": "^18.0.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
